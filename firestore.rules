rules_version = '2';

// Each signed-in person can read and write only their own khata:
// users/{their uid}/entries/{id} and users/{their uid}/events/{id}.
// Nobody else (and nobody signed out) can read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
